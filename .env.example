# ==============================================================================
# AI DOCUMENT RESEARCH ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="AI Document Research Assistant"
DEBUG=true

# Security Secrets (Generate secure random keys with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
CSRF_SECRET=change-this-to-another-secure-random-32-byte-hex-string
SESSION_COOKIE_NAME=doc_assistant_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL with pgvector)
# Standard local URL example: postgresql+asyncpg://postgres:postgres@localhost:5432/doc_assistant
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Document Storage Configuration
# Supported backends: "local" (default for offline dev), "supabase" (production), "mock" (tests)
STORAGE_BACKEND=local
STORAGE_DIR=backend/storage/documents
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf
ALLOWED_MIME_TYPES=application/pdf

# Supabase Storage Configuration (Server-Side ONLY - Never expose in client bundles)
# Required when STORAGE_BACKEND=supabase
# 1. The bucket must be created in Supabase Dashboard as PRIVATE (Public bucket = OFF)
# 2. Key MUST be the SERVICE_ROLE key (Project Settings -> API -> Project API keys -> service_role secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-do-not-share
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_STORAGE_TIMEOUT_SECONDS=30.0

# Chunking & Extraction Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100
MIN_EXTRACTABLE_TEXT_CHARS=50
SCANNED_PAGE_MIN_CHARS=15

# Retrieval & Vector Search Configuration
RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.60
EMBEDDING_DIMENSION=1536

# Embedding Provider Configuration
# Supported providers: "openai", "gemini", "mock" (for offline dev/testing)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

# LLM Provider Configuration
# Supported providers: "openai", "gemini", "mock" (for offline dev/testing)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
